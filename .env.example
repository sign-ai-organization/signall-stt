# Copiar a .env y ajustar según necesidad. docker compose lo lee automáticamente.
#
# Lo que no está acá usa el default de app/config.py, que es el del diagrama 6.3
# del SDD. La lista completa con la descripción de cada variable está en el
# README.

MODEL_SIZE=medium
DEVICE=cuda
COMPUTE_TYPE=float16
LANGUAGE=es

# Default de Whisper. No subir a -1.0 → -0.8: descarta audio que el modelo
# transcribió bien.
AVG_LOGPROB_THRESHOLD=-1.0

# Silencio que cierra una frase. Bajarlo de 1500 a 600 parte las frases donde la
# persona respira, y una frase partida son dos señas.
SILENCE_TIMEOUT_MS=1500

# Los timestamps por palabra los usaba el camino que firmaba por fragmentos, que
# ya no está. Ver la nota en app/config.py antes de prenderlo.
WORD_TIMESTAMPS=false

# Inferencias simultáneas en la GPU. Whisper serializa igual por abajo
# (CTranslate2 con num_workers=1), así que más de uno solo agrega variabilidad.
MAX_CONCURRENT_INFERENCE=1